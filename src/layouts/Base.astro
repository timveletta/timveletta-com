---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { getSiteLocale } from "../utils/locale";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { fade, ClientRouter } from "astro:transitions";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  pageTitle?: string | null;
  description?: string | null;
  image?: string | null;
  canonical?: string | null;
  robots?: string | null;
  type?: "website" | "article";
  publishedTime?: string | null;
  modifiedTime?: string | null;
  author?: string | null;
  /** Pass content reference for plugin page contributions on content pages */
  content?: { collection: string; id: string; slug?: string | null };
}

const {
  title,
  pageTitle,
  description,
  image,
  canonical,
  robots,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
  getSiteSettingsWithCacheHint(),
  getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
  Astro.cache.set(settingsResult.cacheHint);
  Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settingsResult.data);
const titleIncludesSiteName =
  title === siteTitle ||
  title.endsWith(` | ${siteTitle}`) ||
  title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;
const menuItems = menu?.items ?? [];

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: type,
  title: fullTitle,
  pageTitle: pageTitle ?? title,
  description,
  canonical,
  image,
  content,
  seo: { ogImage: image, robots },
  articleMeta: { publishedTime, modifiedTime, author },
  siteName: siteTitle,
});

const lang = getSiteLocale() ?? "en";
---

<!doctype html>
<html lang={lang} transition:animate={fade({ duration: "0.4s" })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
    <title>{fullTitle}</title>
    <EmDashHead page={pageCtx} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteTitle} RSS Feed`}
      href="/rss.xml"
    />
    <ClientRouter />
  </head>
  <body class="dark:bg-gray-900 border-t-8 border-primary flex flex-col min-h-screen">
    <EmDashBodyStart page={pageCtx} />
    <Navigation menuItems={menuItems} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer
      siteTitle={siteTitle}
      siteTagline={siteTagline}
      menuItems={menuItems}
    />
    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
