---
import "./_blog-post.css";
import { decodeSlug } from "emdash";
import { Image, PortableText } from "emdash/ui";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { fade } from "astro:transitions";
import { loadPost, mediaSrc, publishedOn } from "../../lib/blog";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

let post;
try {
  const result = await loadPost(slug);
  post = result.entry;
  if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
} catch (error) {
  console.error("Failed to load post:", error);
  return new Response("Unable to load post", { status: 500 });
}

if (!post) return Astro.rewrite("/404");

const date = publishedOn(post.data.published_on);
const tags = post.data.terms?.tag ?? [];
---

<html lang="en" transition:animate={fade({ duration: "0.4s" })}>
  <head>
    <BaseHead
      title={post.data.title}
      description={post.data.description}
      image={mediaSrc(post.data.featured_image)}
    />
  </head>
  <body class="border-t-8 border-primary dark:bg-gray-900">
    <Header />
    <main>
      <article>
        <div class="container mx-auto max-w-screen-lg my-20 p-2">
          <h1
            class="text-3xl font-extrabold text-gray-900 tracking-tight sm:text-4xl md:text-5xl leading-snug text-center"
            {...post.edit.title}
          >
            {post.data.title}
          </h1>
          {
            date && (
              <time
                datetime={date.toISOString()}
                class="block text-base leading-6 font-medium text-gray-500 text-center my-4"
              >
                {date.toLocaleDateString("en-us", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            )
          }
          {
            post.data.featured_image && (
              <div class="relative" {...post.edit.featured_image}>
                <Image
                  image={post.data.featured_image}
                  alt={`Hero image for post ${post.data.title}`}
                  class="object-cover mb-12 rounded-lg w-full"
                />

                <p class="absolute bottom-4 right-4 bg-gray-200 text-sm px-2 py-1 rounded-md text-gray-800">
                  Photo by{" "}
                  <a class="underline" href={post.data.image_credit_url}>
                    {post.data.image_credit_name}
                  </a>{" "}
                  on
                  <a
                    class="underline"
                    href="https://unsplash.com/?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText"
                  >
                    Unsplash
                  </a>
                </p>
              </div>
            )
          }
          <div class="text-gray-900 leading-loose font-serif text-lg markdown" {...post.edit.content}>
            <PortableText value={post.data.content} />
          </div>
          {
            tags.length ? (
              <div class="my-10">
                <div class="flex items-center flex-wrap">
                  {tags.map((tag) => (
                    <a
                      href={`/tags/${encodeURIComponent(tag.slug)}`}
                      class="flex items-center px-3 py-0.5 mr-1 mb-1 rounded-full font-medium bg-secondary hover:bg-primary text-white"
                    >
                      {tag.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : null
          }
          <a href="/blog" class="font-bold mt-4 py-4 text-primary self-end">
            ← Back to the blog
          </a>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
