---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import BlogPostExcerpt from "../components/BlogPostExcerpt.astro";
import { fade } from "astro:transitions";
import { loadPosts } from "../lib/blog";

let posts = [];
let tagsByEntry = new Map();
try {
  const result = await loadPosts();
  posts = result.entries;
  tagsByEntry = result.tagsByEntry;
  if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
} catch (error) {
  console.error("Failed to load posts:", error);
  return new Response("Unable to load posts", { status: 500 });
}
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: "0.4s" })}>
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class=" dark:bg-gray-900 border-t-8 border-primary">
    <Header />
    <main>
      <div class="container mx-auto my-20 grid grid-cols-1 p-2">
        {
          posts.map((post) => (
            <BlogPostExcerpt post={post} tags={tagsByEntry.get(post.data.id) ?? []} />
          ))
        }
      </div>
    </main>
    <Footer />
  </body>
</html>
