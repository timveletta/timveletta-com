---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../config";
import BlogPostExcerpt from "../../components/BlogPostExcerpt.astro";
import { fade } from "astro:transitions";
import { decodeSlug, getEmDashCollection, getTerm } from "emdash";

const tag = decodeSlug(Astro.params.tag);
const term = tag ? await getTerm("tag", tag, { includeCounts: false }) : null;
if (!term) return Astro.rewrite("/404");

let posts = [];
try {
  const result = await getEmDashCollection("posts", {
    where: { tag: term.slug },
    orderBy: { published_on: "desc" },
  });
  if (result.error) throw result.error;
  posts = result.entries;
  if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
} catch (error) {
  console.error("Failed to load tagged posts:", error);
  return new Response("Unable to load posts", { status: 500 });
}
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: "0.4s" })}>
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} noIndex />
  </head>
  <body class="dark:bg-gray-900">
    <Header />
    <main>
      <div class="container mx-auto my-20">
        <h1
          class="text-3xl text-center dark:text-white font-bold text-gray-800 tracking-wide mb-10 p-2"
        >
          Blog posts tagged "{term.label}"
        </h1>
        <div class="grid grid-cols-1 gap-8 p-2">
          {
            posts.map((post) => (
              <BlogPostExcerpt post={post} tags={[{ slug: term.slug, label: term.label }]} />
            ))
          }
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
