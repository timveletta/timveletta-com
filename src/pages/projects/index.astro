---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const {
  entries: projects,
  cacheHint,
  error,
} = await getEmDashCollection("projects", {
  orderBy: {
    published_at: "desc",
  },
});

if (error) return new Response("Unable to load projects", { status: 500 });

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Things I've Built">
  <header aria-labelledby="all-projects" class="mt-12">
    <SectionHeader id="all-projects" label="Things I've Built" />
  </header>

  <section class="container mx-auto px-4 py-12">
    <div>
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Base>
