---
import {
  getEmDashCollection,
  getTermsForEntries,
  getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { ChevronRightIcon } from "@heroicons/react/24/outline";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const POSTS_PER_PAGE = 6;
const NUM_PROJECTS_SHOWN = 4;

const [
  { entries: posts, cacheHint: postsCacheHint },
  { entries: projects, cacheHint: projectsCacheHint },
  settings,
] = await Promise.all([
  getEmDashCollection("posts", {
    orderBy: { published_at: "desc" },
    limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
  }),
  getEmDashCollection("projects", {
    orderBy: { published_at: "desc" },
    limit: NUM_PROJECTS_SHOWN,
  }),
  getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) {
  Astro.cache.set(postsCacheHint);
  Astro.cache.set(projectsCacheHint);
}

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

const tagEntryIds = visiblePosts.map((p) => p.data.id);
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const gridPostsWithTags = visiblePosts.map((post) => ({
  post,
  tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
    slug: t.slug,
    label: t.label,
  })),
}));
---

<Base title={siteTitle} description={siteTagline}>
  <Hero />

  <section aria-labelledby="recent-posts">
    <div class="container px-4 mx-auto py-24">
      <SectionHeader id="recent-posts" label="Recent Articles" />
      <div class="grid md:grid-cols-3 grid-cols-1 gap-6">
        {gridPostsWithTags.map(({ post, tags }) => (
          <PostCard post={post} tags={tags} />
        ))}
      </div>
      {hasMorePosts && (
        <a
          href="/posts"
          class="flex items-center justify-end mx-auto mt-8 text-gray-900 dark:text-gray-100 dark:hover:text-primary hover:text-primaryAA"
        >
          View all<span class="sr-only"> posts</span>
          <ChevronRightIcon className="size-5" />
        </a>
      )}
    </div>
  </section>

  {projects.length > 0 && (
    <section aria-labelledby="recent-projects">
      <div class="container px-4 mx-auto py-24">
        <SectionHeader id="recent-projects" label="Things I've Built" />
        <div class="">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
