---
import { ArrowRightIcon, ArrowLeftIcon } from "@heroicons/react/24/outline";

interface Props {
  /** Path of the first page, e.g. "/posts" */
  basePath: string;
  currentPage: number;
  hasMore?: boolean;
}

const { basePath, currentPage, hasMore } = Astro.props;
---

<nav aria-label="Pagination" class="flex justify-between">
  <div>
    {currentPage > 1 && (
      <a
        href={`${basePath}/${currentPage - 1}`}
        class="text-gray-900 dark:text-gray-100 font-semibold hover:text-primaryAA flex items-center"
      >
        <ArrowLeftIcon className="size-4 mr-2" />
        Previous page
      </a>
    )}
  </div>
  <div>
    {hasMore && (
      <a
        href={`${basePath}/${currentPage + 1}`}
        class="text-gray-900 dark:text-gray-100 font-semibold hover:text-primaryAA flex items-center"
      >
        Next page
        <ArrowRightIcon className="size-4 ml-4" />
      </a>
    )}
  </div>
</nav>
