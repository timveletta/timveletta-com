---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { formatDate } from "../utils/locale";
import { formatReadingTime, getReadingTime } from "../utils/reading-time";
import Tags from "./Tags.astro";

interface Props {
  post: ContentEntry<InferCollectionData<"posts">>;
  tags?: Array<{ slug: string; label: string }>;
}

const { post, tags = [] } = Astro.props;

const href = `/posts/${post.id}`;
const title = post.data.title || "Untitled";
const publishedAt = post.data.publishedAt ?? null;
const readingTime = formatReadingTime(getReadingTime(post.data.content));
const bylines = post.data.bylines ?? [];
---

<article class="group relative flex flex-col min-w-0 p-2 rounded-xl bg-white dark:bg-slate-800 ring ring-gray-200 dark:ring-gray-700 shadow-sm hover:shadow-md transition duration-300 ease-in-out">
  <a
    href={href}
    class="relative block overflow-hidden aspect-video rounded-lg bg-gray-500"
    tabindex="-1"
    aria-hidden="true"
  >
    {post.data.featured_image ? (
      <div
        class="h-full group-hover:scale-105 transition duration-300 ease-in-out"
        {...post.edit.featured_image}
      >
        <Image image={post.data.featured_image} />
      </div>
    ) : (
      <div class="absolute inset-0 bg-linear-to-r from-cyan-500 to-blue-500" />
    )}
  </a>
  <div class="flex flex-1 flex-col min-w-0">
    <a href={href} class="px-3 py-4 flex flex-col gap-2">
      <span class="flex flex-wrap items-center gap-2 text-xs text-gray-600 dark:text-gray-400 tabular-nums">
        {publishedAt && (
          <time datetime={publishedAt.toISOString()}>
            {formatDate(publishedAt, "short")}
          </time>
        )}
        <span>{readingTime}</span>
      </span>
      <h3
        class="text-lg leading-snug group-hover:underline text-slate-900 dark:text-white"
        {...post.edit.title}
      >
        {title}
      </h3>
      {post.data.excerpt && (
        <p
          class="line-clamp-2 overflow-hidden text-sm text-gray-800 dark:text-gray-200 leading-normal data-emdash-editing:block data-emdash-editing:line-clamp-none"
          {...post.edit.excerpt}
        >
          {post.data.excerpt}
        </p>
      )}
    </a>
    {(bylines.length > 0 || tags.length > 0) && (
      <div class="flex flex-col justify-between gap-3 mt-auto px-3 py-2">
        <Tags tags={tags} />
      </div>
    )}
  </div>
</article>
