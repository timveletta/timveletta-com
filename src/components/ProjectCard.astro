---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";

import GithubIcon from "../images/github.svg";
import Tags from "./Tags.astro";

import { ArrowTopRightOnSquareIcon } from "@heroicons/react/16/solid";

interface Props {
  project: ContentEntry<InferCollectionData<"projects">>;
}

const { project } = Astro.props;

const href = `/projects/${project.id}`;
const title = project.data.title || "Untitled";

const tags = project.data.terms?.project_tags || [];
---

<div class="group flex mb-16 md:pl-0 md:border-l-8 md:border-primary mx-auto flex-wrap">
  <div class="xl:basis-2/3 md:basis-1/2 md:px-8 py-4 flex flex-col">
    <a
      href={href}
      class="text-xl font-bold dark:text-primary text-gray-900 group-hover:text-primaryAA"
    >
      {title}
    </a>
    <p class="mt-3 text-base leading-loose dark:text-gray-200 text-gray-500 mb-auto">
      {project.data.excerpt}
    </p>
    <div class="flex gap-6 mt-4">
      {project.data.website_link && (
        <a
          href={project.data.website_link}
          target="_blank"
          class="text-primaryAA hover:text-primary text-sm font-bold mr-2 flex items-center"
        >
          <ArrowTopRightOnSquareIcon className="size-6 mr-2 fill-primaryAA" />
          View Site
        </a>
      )}
      {project.data.github_link && (
        <a
          href={project.data.github_link}
          class="text-primaryAA hover:text-primary text-sm font-bold mr-2 flex items-center"
        >
          <GithubIcon class="size-5 mr-2 fill-primaryAA" />
          View on Github
        </a>
      )}
      <div class="ml-auto flex">
        <Tags tags={tags} />
      </div>
    </div>
  </div>
  <div class="xl:basis-1/3 md:basis-1/2 w-full my-auto relative overflow-hidden rounded-lg">
    <a href={href}>
      <div class="h-full group-hover:scale-105 transition duration-300 ease-in-out">
        <Image
          class="w-full object-cover"
          image={project.data.featured_image}
          alt={`Featured image for project ${title}`}
        />
      </div>
    </a>
  </div>
</div>
